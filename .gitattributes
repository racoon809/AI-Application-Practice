# 줄바꿈 정책: 텍스트 파일은 저장소에 LF로 저장하고, 체크아웃할 때 OS에 맞게 변환
* text=auto

# Windows 배치 파일은 항상 CRLF 줄바꿈으로 받기 (LF면 cmd가 줄을 잘못 읽을 수 있음)
*.bat text eol=crlf

# 소스·문서는 어디서 받아도 LF로 통일
*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf

# 바이너리 (줄바꿈 변환·diff 금지)
*.png binary
*.jpg binary
*.npz binary
*.zip binary
